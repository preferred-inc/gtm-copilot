# Google Tag Manager API OAuth 2.0 Credentials (for token refresh)
GTM_CLIENT_ID=your_client_id_here
GTM_CLIENT_SECRET=your_client_secret_here
GTM_REFRESH_TOKEN=your_refresh_token_here

# Anthropic API Key (for AI generation feature)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Environment: "development" or "production"
# ENV=development

# Frontend URL (used for CORS and OAuth redirect)
# FRONTEND_URL=http://localhost:3000

# OAuth callback URI
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# CORS origins (comma-separated, overrides FRONTEND_URL if set)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
